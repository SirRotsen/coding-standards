#!/bin/sh
#
# The one file a repository vendors. Every command it runs is fetched from
# coding-standards at run time, so a change to what `session-start` prints or
# what `drop` sends ships from that repo alone and never needs a PR here.
#
# Installing it into a repo: see "How a repo consumes this" in the
# coding-standards README, which is the one copy of those steps.
set -u

REF="${HQ_BOOTSTRAP_REF:-main}"

# The ref goes into a URL path, and curl resolves `..` before sending, so an
# unchecked ref of `../../owner/repo/main` fetches and runs code from any
# repository on GitHub—in the one process that holds HQ_DROP_TOKEN and is
# allowlisted to run unprompted. Ref characters only, and no dot segments.
# --path-as-is below is the second layer: unsquashed, a traversal 404s.
case "$REF" in
  *..*|/*|*/|*[!A-Za-z0-9._/-]*)
    echo "hq: refusing the ref '$REF'—letters, digits, dot, dash, underscore and slash only" >&2
    exit 2
    ;;
esac

BASE="https://raw.githubusercontent.com/SirRotsen/coding-standards/$REF/payload"

# Keyed by ref as well as command, so testing a branch cannot leave that
# branch's code sitting in the slot the next ordinary run reads. The checksum
# keeps `fix/a` and `fix_a` apart, which flattening slashes alone would not.
SAFE_REF="$(printf '%s' "$REF" | tr '/' '_').$(printf '%s' "$REF" | cksum | cut -d' ' -f1)"

ROOT="${CLAUDE_PROJECT_DIR:-}"
[ -n "$ROOT" ] || ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd) || {
  echo "hq: cannot resolve the repository root" >&2
  [ "${1:-}" = "session-start" ] && exit 0 || exit 1
}
CACHE="$ROOT/.claude/.cache"

cmd="${1:-}"
[ -n "$cmd" ] && shift || { echo "usage: .claude/bin/hq <session-start|drop> [args]" >&2; exit 2; }

# Named commands only. The command becomes part of a URL, so anything else
# would let an argument choose what gets fetched and run.
case "$cmd" in
  session-start|drop) ;;
  *) echo "hq: unknown command: $cmd" >&2; exit 2 ;;
esac

# A half-written file, an HTML error page, or a proxy's captive-portal login all
# arrive over a successful-looking fetch. A payload is a script: it starts with
# a shebang and is not a stub. The floor is well under the smallest real payload
# and well over any placeholder or truncated first packet.
usable() {
  [ -s "$1" ] && [ "$(head -c 2 "$1" 2>/dev/null)" = '#!' ] && [ "$(wc -c <"$1")" -ge 200 ]
}

CACHED="$CACHE/$SAFE_REF.$cmd"
run=""

tmp=$(mktemp 2>/dev/null) || tmp=""
if [ -n "$tmp" ]; then
  if curl -fsSL --path-as-is --connect-timeout 3 --max-time 10 "$BASE/$cmd" -o "$tmp" 2>/dev/null && usable "$tmp"; then
    run="$tmp"
    # Written under a name no other process shares, then moved into place: a
    # copy interrupted by a full disk, a signal, or a second session starting on
    # this checkout would still begin with a shebang and pass usable() on the
    # next run. A shared intermediate name would just move the race one step
    # later, and its cleanup would delete the other session's file.
    staged="$CACHED.$$.new"
    if mkdir -p "$CACHE" 2>/dev/null; then
      # The cache ignores itself. A repo whose .gitignore missed this line would
      # commit fetched, executable code that no review ever saw, and the line is
      # one step in a conversion done 21 times by hand.
      [ -f "$CACHE/.gitignore" ] || printf '*\n' >"$CACHE/.gitignore" 2>/dev/null
    fi
    if [ -d "$CACHE" ] && cp "$tmp" "$staged" 2>/dev/null; then
      chmod 0755 "$staged" 2>/dev/null
      if mv -f "$staged" "$CACHED" 2>/dev/null; then
        run="$CACHED"
      else
        rm -f "$staged"
      fi
    fi
    # An unwritable .claude—read-only checkout, root-owned directory in a
    # container—costs the cache, never the run: the payload in hand already
    # passed usable().
  else
    rm -f "$tmp"
    tmp=""
  fi
fi

# Offline, or coding-standards unreachable: run the last payload that arrived
# intact. Slightly stale beats nothing, and nothing is what a bootstrap costs if
# it insists on a fresh copy.
[ -n "$run" ] || { usable "$CACHED" && run="$CACHED"; }

if [ -z "$run" ]; then
  if [ "$cmd" = "session-start" ]; then
    exit 0  # a session without the standards is degraded, never blocked
  fi
  echo "hq: could not fetch $cmd from coding-standards, and no cached copy exists" >&2
  exit 1
fi

chmod 0755 "$run" 2>/dev/null

# exec never returns, so the temporary copy has to go now. It is kept only when
# it is the thing about to run, which happens when the cache is unwritable.
[ -n "$tmp" ] && [ "$run" != "$tmp" ] && rm -f "$tmp"

# The payload runs from the cache directory, so it cannot find the repository by
# looking beside itself.
HQ_REPO_ROOT="$ROOT"
export HQ_REPO_ROOT

# The payload fetches documents from the same ref it was itself fetched from, so
# testing a branch tests the whole thing. It takes the validated URL from here
# rather than re-reading HQ_BOOTSTRAP_REF, which would need validating twice.
HQ_STANDARDS_BASE="https://raw.githubusercontent.com/SirRotsen/coding-standards/$REF"
export HQ_STANDARDS_BASE

exec "$run" "$@"
